LangString addOrReinstall ${LANG_URDU} "اجزاء شامل / دوبارہ انسٹال کریں"
LangString alreadyInstalled ${LANG_URDU} "پہلے سے انسٹال ہے"
LangString alreadyInstalledLong ${LANG_URDU} "${PRODUCTNAME} ${VERSION} پہلے سے انسٹال ہے۔ جو عمل آپ کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے $\"آگے$\" پر کلک کریں۔"
LangString appRunning ${LANG_URDU} "${PRODUCTNAME} چل رہا ہے! براہ کرم پہلے اسے بند کریں اور پھر دوبارہ کوشش کریں۔"
LangString appRunningOkKill ${LANG_URDU} "${PRODUCTNAME} چل رہا ہے!$\nاسے بند کرنے کے لیے OK پر کلک کریں"
LangString chooseMaintenanceOption ${LANG_URDU} "دیکھ بھال کا وہ اختیار منتخب کریں جو آپ کرنا چاہتے ہیں۔"
LangString choowHowToInstall ${LANG_URDU} "منتخب کریں کہ آپ ${PRODUCTNAME} کیسے انسٹال کرنا چاہتے ہیں۔"
LangString createDesktop ${LANG_URDU} "ڈیسک ٹاپ شارٹ کٹ بنائیں"
LangString dontUninstall ${LANG_URDU} "ان انسٹال نہ کریں"
LangString dontUninstallDowngrade ${LANG_URDU} "ان انسٹال نہ کریں (اس انسٹالر میں ان انسٹال کیے بغیر پرانا ورژن انسٹال کرنا بند ہے)"
LangString failedToKillApp ${LANG_URDU} "${PRODUCTNAME} بند نہیں ہو سکا۔ براہ کرم پہلے اسے بند کریں اور پھر دوبارہ کوشش کریں"
LangString installingWebview2 ${LANG_URDU} "WebView2 انسٹال ہو رہا ہے..."
LangString newerVersionInstalled ${LANG_URDU} "${PRODUCTNAME} کا نیا ورژن پہلے سے انسٹال ہے! پرانا ورژن انسٹال کرنے کی سفارش نہیں کی جاتی۔ اگر آپ واقعی پرانا ورژن انسٹال کرنا چاہتے ہیں تو بہتر ہے کہ پہلے موجودہ ورژن ان انسٹال کر دیں۔ جو عمل آپ کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے $\"آگے$\" پر کلک کریں۔"
LangString older ${LANG_URDU} "پرانا"
LangString olderOrUnknownVersionInstalled ${LANG_URDU} "آپ کے سسٹم پر ${PRODUCTNAME} کا $R4 ورژن انسٹال ہے۔ انسٹال کرنے سے پہلے موجودہ ورژن ان انسٹال کرنے کی سفارش کی جاتی ہے۔ جو عمل آپ کرنا چاہتے ہیں اسے منتخب کریں اور جاری رکھنے کے لیے $\"آگے$\" پر کلک کریں۔"
LangString silentDowngrades ${LANG_URDU} "اس انسٹالر میں پرانا ورژن انسٹال کرنا بند ہے، خاموش انسٹالر جاری نہیں رہ سکتا۔ براہ کرم عام (گرافیکل) انسٹالر استعمال کریں۔$\n"
LangString unableToUninstall ${LANG_URDU} "ان انسٹال نہیں ہو سکا!"
LangString uninstallApp ${LANG_URDU} "${PRODUCTNAME} ان انسٹال کریں"
LangString uninstallBeforeInstalling ${LANG_URDU} "انسٹال کرنے سے پہلے ان انسٹال کریں"
LangString unknown ${LANG_URDU} "نامعلوم"
LangString webview2AbortError ${LANG_URDU} "WebView2 انسٹال نہیں ہو سکا! اس کے بغیر ایپ نہیں چل سکتی۔ انسٹالر دوبارہ چلا کر دیکھیں۔"
LangString webview2DownloadError ${LANG_URDU} "خرابی: WebView2 ڈاؤن لوڈ ناکام ہو گیا - $0"
LangString webview2DownloadSuccess ${LANG_URDU} "WebView2 بوٹ اسٹریپر کامیابی سے ڈاؤن لوڈ ہو گیا"
LangString webview2Downloading ${LANG_URDU} "WebView2 بوٹ اسٹریپر ڈاؤن لوڈ ہو رہا ہے..."
LangString webview2InstallError ${LANG_URDU} "خرابی: WebView2 کی انسٹالیشن ایگزٹ کوڈ $1 کے ساتھ ناکام ہو گئی"
LangString webview2InstallSuccess ${LANG_URDU} "WebView2 کامیابی سے انسٹال ہو گیا"
LangString deleteAppData ${LANG_URDU} "ایپلیکیشن کا ڈیٹا حذف کریں"

; ReeliF Capture additions (used by src-tauri/nsis/hooks.nsh)
LangString reelifWelcomeTitle ${LANG_URDU} "${PRODUCTNAME} میں خوش آمدید"
LangString reelifWelcomeText ${LANG_URDU} "ریکارڈ کریں۔ کلک کریں۔ زوم۔$\r$\n$\r$\nیہ وزرڈ ${MANUFACTURER} کا ${PRODUCTNAME} ${VERSION} انسٹال کرے گا: ایک اسکرین ریکارڈر جو آپ کے کلکس پر نرم زوم کرتا ہے، کیمرہ ببل، بیک گراؤنڈ فریم اور ایکسپورٹ سے پہلے فوری کٹ کے ساتھ۔$\r$\n$\r$\nریکارڈنگز اسی کمپیوٹر پر آپ کے Videos\ReeliF Capture فولڈر میں رہتی ہیں۔ کچھ بھی اپ لوڈ نہیں ہوتا۔$\r$\n$\r$\n$_CLICK"
LangString reelifFinishTitle ${LANG_URDU} "${PRODUCTNAME} تیار ہے"
LangString reelifFinishText ${LANG_URDU} "${PRODUCTNAME} اس کمپیوٹر پر انسٹال ہو گیا ہے۔$\r$\n$\r$\nیہ اسکرین کے نیچے ایک چھوٹی کیپچر بار کی صورت میں کھلتا ہے۔ ریکارڈ کرنے کے لیے سرخ بٹن دبائیں؛ روکنے پر ایڈیٹر آپ کی لائبریری پر کھلتا ہے۔$\r$\n$\r$\nوزرڈ بند کرنے کے لیے $\"ختم کریں$\" پر کلک کریں۔"
LangString reelifStoppingRunning ${LANG_URDU} "فائلیں اپ ڈیٹ کرنے کے لیے ${PRODUCTNAME} کے چلتے ہوئے پروسیس بند کیے جا رہے ہیں..."
